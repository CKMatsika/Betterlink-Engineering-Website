# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical/OG metadata).
NEXT_PUBLIC_SITE_URL=https://www.betterlinkengineering.co.zw

# ── Contact form email delivery (Resend) ─────────────────────
# Get an API key at https://resend.com/api-keys (starts with "re_").
RESEND_API_KEY=

# Inbox that receives website enquiries.
CONTACT_TO_EMAIL=info@betterlinkengineering.co.zw

# Sender address. Must be on a domain verified in Resend.
CONTACT_FROM_EMAIL=Betterlink Engineering <website@betterlinkengineering.co.zw>

# ── Supabase (admin backend: database, auth, storage) ────────
# Project URL and keys from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# NOTE: The original Rocket.new export also shipped placeholder variables
# (Supabase, OpenAI, Gemini, Anthropic, Perplexity, Stripe, GA, AdSense).
# None are referenced by the current codebase; add them here only if you
# wire up those services later.
